+        "convrot": convrot,
+        "convrot_groupsize": convrot_groupsize,
+        "input_act": input_act,
+        "input_act_weight": input_act_weight,
+        "input_act_eps": input_act_eps,
+        "residual": residual,
+        "residual_scale": residual_scale,
